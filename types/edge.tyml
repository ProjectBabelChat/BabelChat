// Edge API (public)
//
// The only API reachable from the internet. Clients never learn which cell
// holds a guild: these types deliberately carry no cell names, epochs or
// placement versions, and "not found" and "forbidden" are the same error.
//
// Edges verify tokens locally, rate-limit, resolve placement and fan events
// out to connected clients.
//
// See docs/architecture/edge.md.

type Claim {
    /// User ID.
    sub: string
    name: string
    iat: int
    exp: int
}

type Registration {
    name: string
    password: string
    /// BCP 47, e.g. "ja-JP".
    locale: string
    /// Needed when the server takes new accounts by invitation only.
    signup_code: string?
}

type Credentials {
    name: string
    password: string
}

type Token {
    jwt: string
    user_id: string
    /// As registered; sign-in ignores case.
    name: string
    expires_at: int
}

type PasswordChange {
    password: string
    new_password: string
}

type UserSettings {
    locale: string
    /// Translate on device even languages a guild does not declare.
    translate_outside_set: bool
    show_original: bool
}

// ---- Guilds ----------------------------------------------------------------

type Guild {
    id: string
    name: string
    description: string?
    owner_id: string
    created_at: int
}

enum ChannelKind {
    "category"
    "text"
    "thread"
}

type Channel {
    id: string
    guild_id: string
    kind: ChannelKind
    name: string
    topic: string?
    parent_id: string?
    starter_message_id: string?
    created_at: int
    /// Newest message ever sent here. The channel is unread while it is
    /// newer than the read state's `last_read_id`.
    last_message_id: string?
    /// Who made it, when known. A thread's creator may rename and
    /// delete it.
    created_by: string?
}

type Member {
    user_id: string
    name: string
    owner: bool
    joined_at: int
}

enum RegionMode {
    "merged"
    "distinct"
}

type LanguageAlias {
    from: string
    to: string
}

type LanguagePolicy {
    guild_id: string
    /// "free", "paid1", "paid2" or "paid3".
    plan: string
    languages: [string]
    llm_languages: [string]
    max_languages: int
    max_llm_languages: int
    region_mode: RegionMode
    aliases: [LanguageAlias]
    translate_regional_variants: bool
    /// What the LLM translates with, one of `get_models`. Null: the
    /// default model.
    model: string?
}

/// A model a guild can translate with.
type TranslationModel {
    id: string
    name: string
}

/// How the current user reads a guild. Computed by the Edge from the user's
/// settings and the guild's policy, so clients need no normalization tables.
type LanguageView {
    /// The user's locale normalized with the guild's policy.
    effective: string
    in_set: bool
    /// Translations into `effective` come from the LLM.
    llm: bool
    /// The client should translate on device into `effective`.
    client_translation: bool
}

/// How far the user has read one channel.
type ReadState {
    channel_id: string
    /// Later messages are unread. Starts at the member's join time, so it
    /// may name no message.
    last_read_id: string
    /// Messages after `last_read_id` that mention the user.
    mention_count: int
}

enum NotifyLevel {
    "all"
    "mentions"
    "none"
}

type ChannelNotify {
    channel_id: string
    level: NotifyLevel
}

/// What the user wants to be notified of in one guild. Channel entries
/// override the guild's level; a thread follows its channel unless it has
/// its own entry. Clients decide what to show; the server keeps the choice.
type NotificationSettings {
    guild_id: string
    level: NotifyLevel
    channels: [ChannelNotify]
}

type Ban {
    user_id: string
    name: string
    banned_by: string
    banned_at: int
}

/// A guild's own emoji. Its members use it in any guild, in text and in
/// reactions, written `<:name:guild_id.id>`; everyone signed in sees it.
type Emoji {
    id: string
    guild_id: string
    /// 2 to 32 ASCII letters, digits and underscores; unique in the guild.
    name: string
    /// The image: `GET` with the token, like attachments; the same as
    /// `/media/<guild_id>/-/<id>`, which readers of a code build.
    url: string
    created_by: string
    created_at: int
}

type GuildView {
    guild: Guild
    channels: [Channel]
    members: [Member]
    policy: LanguagePolicy
    language: LanguageView
    /// The user's, one per channel.
    read_states: [ReadState]
    notifications: NotificationSettings
    /// The guild's own emoji, oldest first.
    emoji: [Emoji]
}

type NewGuild {
    name: string
    description: string?
}

type NewChannel {
    guild_id: string
    kind: ChannelKind
    name: string
    topic: string?
    parent_id: string?
    starter_message_id: string?
}

type Invite {
    /// Share this: anyone holding it can join until it expires or runs out.
    code: string
    guild_id: string
    created_by: string
    created_at: int
    expires_at: int?
    max_uses: int?
    uses: int
}

type NewInvite {
    guild_id: string
    /// Seconds until the invite expires: 7 days when absent, never when 0.
    max_age_secs: int?
    max_uses: int?
}

type GuildUpdate {
    guild_id: string
    name: string
    description: string?
}

type ChannelUpdate {
    guild_id: string
    channel_id: string
    name: string
    topic: string?
}

type LanguagePolicyUpdate {
    guild_id: string
    languages: [string]
    llm_languages: [string]
    region_mode: RegionMode
    aliases: [LanguageAlias]
    translate_regional_variants: bool
    model: string?
}

// ---- Messages --------------------------------------------------------------

/// A file sent with a message.
type Attachment {
    id: string
    name: string
    /// Read from the file by the server, not taken from the sender:
    /// `image/png`, `image/jpeg`, `image/gif`, `image/webp`, a few
    /// others, else `application/octet-stream`.
    content_type: string
    size: int
    /// Of images.
    width: int?
    height: int?
    /// Where to download it on this server: `GET` with the token, like the
    /// API. Images come back as themselves, anything else as a download
    /// (`Content-Disposition: attachment`).
    url: string
}

/// One emoji people reacted with.
type Reaction {
    /// A Unicode emoji, or a guild's emoji as `<:name:guild_id.id>`.
    emoji: string
    count: int
    /// The user is among them.
    me: bool
}

type Message {
    id: string
    guild_id: string
    channel_id: string
    author_id: string
    author_name: string
    text: string
    /// A message in the same channel this one answers.
    reply_to: string?
    /// Users this message notifies: members named with `@name` in the text,
    /// and the author of the message replied to. Set by the server.
    mentions: [string]
    rev: int
    created_at: int
    edited_at: int?
    /// In the order first used. Reacting changes neither `rev` nor
    /// `edited_at`.
    reactions: [Reaction]
    /// In the order sent. Edits keep them.
    attachments: [Attachment]
}

type Translation {
    lang: string
    text: string
}

/// Translations of one message, filtered to what the user needs: their own
/// language and English (the pivot for on-device translation).
type MessageTranslation {
    message_id: string
    channel_id: string
    /// Revision of the text these translations were made from. Ignore them
    /// when it differs from the message's `rev`.
    rev: int
    /// Detected source language; on-device translation starts from it.
    source_lang: string
    /// "done", "pending", "budget_exceeded" or "failed".
    status: string
    translations: [Translation]
}

type MessageView {
    message: Message
    translation: MessageTranslation?
}

type NewMessage {
    guild_id: string
    channel_id: string
    /// `@name` notifies that member. A guild's emoji is written
    /// `<:name:guild_id.id>`; codes of emoji the user may not use (of
    /// guilds they are not in, or deleted) become `:name:`.
    text: string
    reply_to: string?
    /// IDs of the user's uploads to this channel (`POST /media/upload`),
    /// at most 10; with any, `text` may be empty.
    attachments: [string]?
}

type MessageEdit {
    guild_id: string
    channel_id: string
    message_id: string
    text: string
}

/// Someone added or took back a reaction.
type ReactionChange {
    channel_id: string
    message_id: string
    emoji: string
    user_id: string
    /// How many reacted with `emoji` after the change: set it, do not add.
    count: int
}

/// Someone is writing. Show it for about 10 seconds, or until their
/// message arrives.
type Typing {
    channel_id: string
    user_id: string
}

// ---- Gateway ---------------------------------------------------------------

type Ready {
    session_id: string
    user_id: string
    guilds: [GuildView]
    /// Pass as `after` to the first poll.
    cursor: int
}

enum EventKind {
    "guild_joined"
    /// Renamed, or a new description (`guild_info`).
    "guild_updated"
    /// The owner deleted it: forget it.
    "guild_deleted"
    "member_joined"
    /// For the leaving user too: their last event from the guild.
    "member_left"
    /// Kicked or banned.
    "member_removed"
    "channel_created"
    /// Renamed, a new topic, or out of a deleted category.
    "channel_updated"
    /// With its messages. A channel's threads go first, each with its own
    /// event.
    "channel_deleted"
    "message_created"
    "message_edited"
    "message_deleted"
    "reaction_added"
    "reaction_removed"
    /// The guild's emoji (`emoji`).
    "emoji_created"
    "emoji_deleted"
    "typing"
    "message_translated"
    "policy_updated"
    /// The user read a channel, here or on another device.
    "read_state_updated"
    "notifications_updated"
}

type DeletedMessage {
    channel_id: string
    message_id: string
}

/// One event for this session. Exactly one payload is set, chosen by `kind`.
type Event {
    seq: int
    kind: EventKind
    guild_id: string
    guild: GuildView?
    /// For guild_updated.
    guild_info: Guild?
    member: Member?
    channel: Channel?
    message: Message?
    deleted: DeletedMessage?
    reaction: ReactionChange?
    emoji: Emoji?
    typing: Typing?
    translation: MessageTranslation?
    /// For policy_updated: the new policy and the user's resulting view.
    policy: LanguagePolicy?
    language: LanguageView?
    read_state: ReadState?
    notifications: NotificationSettings?
}

/// When `poll` fails with `not_found` the session is gone (the Edge
/// restarted, or the client fell further behind than the Edge keeps):
/// connect again and reload what is on screen.
type EventBatch {
    events: [Event]
    /// Pass as `after` to the next poll.
    next: int
}

enum ApiError {
    /// Also returned when the guild exists but the user may not see it, so
    /// IDs cannot be probed.
    "not_found"
    "unauthorized"
    "invalid_request"
    "invalid_language"
    "limit_exceeded"
    "name_taken"
    "invalid_credentials"
    "rate_limited"
    "unavailable"
    /// The server takes no new accounts.
    "signups_closed"
    /// The server takes new accounts by invitation, and the code is
    /// missing, expired or used up.
    "invalid_signup_code"
}

interface Auth {
    function register(@body: Registration) -> Token throws ApiError

    function login(@body: Credentials) -> Token throws ApiError
}

interface Me {
    #[kind = "get"]
    authed function get_settings(@claim: Claim) -> UserSettings throws ApiError

    authed function put_settings(@claim: Claim, @body: UserSettings) -> UserSettings throws ApiError

    /// Signs the user's other devices out, like `sign_out_others`. A wrong
    /// current password is `invalid_credentials`.
    authed function change_password(@claim: Claim, @body: PasswordChange) -> Token throws ApiError

    /// Every other token of the user stops working and the user's sessions
    /// end; the answer is a new token for this device (its own session ends
    /// too: connect again with the new token).
    authed function sign_out_others(@claim: Claim) -> Token throws ApiError
}

interface Guilds {
    authed function create_guild(@claim: Claim, @body: NewGuild) -> GuildView throws ApiError

    /// Any member may invite.
    authed function create_invite(@claim: Claim, @body: NewInvite) -> Invite throws ApiError

    /// The invite's creator or the owner may revoke it.
    authed function revoke_invite(@claim: Claim, code: string) throws ApiError

    /// Valid invites: all of them for the owner, the user's own otherwise.
    #[kind = "get"]
    authed function get_invites(@claim: Claim, guild_id: string) -> [Invite] throws ApiError

    /// Joins with an invite code. Invalid, expired and used-up codes are all
    /// `not_found`.
    authed function join_guild(@claim: Claim, invite: string) -> GuildView throws ApiError

    #[kind = "get"]
    authed function get_guild(@claim: Claim, guild_id: string) -> GuildView throws ApiError

    /// Owner only.
    authed function update_guild(@claim: Claim, @body: GuildUpdate) -> Guild throws ApiError

    /// Owner only. Deletes everything the guild holds, for good.
    authed function delete_guild(@claim: Claim, guild_id: string) throws ApiError

    authed function create_channel(@claim: Claim, @body: NewChannel) -> Channel throws ApiError

    /// The owner; for a thread, its creator too.
    authed function update_channel(@claim: Claim, @body: ChannelUpdate) -> Channel throws ApiError

    /// The owner; for a thread, its creator too. A channel's threads and
    /// messages go with it; a category's channels stay, outside it.
    authed function delete_channel(@claim: Claim, guild_id: string, channel_id: string) throws ApiError

    /// Only the owner may change the policy. Languages are normalized and
    /// counted after normalization.
    authed function put_language_policy(@claim: Claim, @body: LanguagePolicyUpdate) -> LanguagePolicy throws ApiError

    /// Models the guild may translate with; the first is the default.
    #[kind = "get"]
    authed function get_models(@claim: Claim, guild_id: string) -> [TranslationModel] throws ApiError

    /// The owner cannot leave (`invalid_request`).
    authed function leave_guild(@claim: Claim, guild_id: string) throws ApiError

    /// Owner only. With `ban`, invites no longer let the user back in.
    authed function remove_member(@claim: Claim, guild_id: string, user_id: string, ban: bool) throws ApiError

    authed function unban_member(@claim: Claim, guild_id: string, user_id: string) throws ApiError

    #[kind = "get"]
    authed function get_bans(@claim: Claim, guild_id: string) -> [Ban] throws ApiError

    /// Saved for the user's other devices; they hear `notifications_updated`.
    authed function put_notification_settings(@claim: Claim, @body: NotificationSettings) -> NotificationSettings throws ApiError

    /// Owner only. Emoji are added by uploading their image (`POST
    /// /media/emoji`, see `Messages`). Texts and reactions naming a deleted
    /// emoji show its name.
    authed function delete_emoji(@claim: Claim, guild_id: string, emoji_id: string) throws ApiError
}

/// Files go up and down outside the JSON API, with the same token
/// (`Authorization: Bearer`):
///
///   POST /media/upload?guild_id=&channel_id=&name=   body: the file
///       -> Attachment (JSON). Up to 10 MB (`limit_exceeded`); the user
///       must be allowed to write in the channel. Send it within a day.
///   GET  <Attachment.url>  -> the file, for the guild's members.
///   POST /media/emoji?guild_id=&name=   body: a PNG, JPEG, GIF or WebP
///       -> Emoji (JSON), the guild's new emoji. Owner only; up to 256 KB
///       and 50 emoji per guild (`limit_exceeded`); `name_taken`.
///   GET  <Emoji.url>  -> the image, for anyone signed in.
///
/// Errors are ApiError as JSON with 400, like the API's (401 without a
/// valid token).
interface Messages {
    authed function send_message(@claim: Claim, @body: NewMessage) -> MessageView throws ApiError

    authed function edit_message(@claim: Claim, @body: MessageEdit) -> MessageView throws ApiError

    authed function delete_message(@claim: Claim, guild_id: string, channel_id: string, message_id: string) throws ApiError

    /// `emoji` is one Unicode emoji, or the code of a guild's emoji the
    /// user may use (of a guild they are in). Reacting twice with the same
    /// one changes nothing. A message holds at most 20 different emoji.
    authed function add_reaction(@claim: Claim, guild_id: string, channel_id: string, message_id: string, emoji: string) -> Message throws ApiError

    authed function remove_reaction(@claim: Claim, guild_id: string, channel_id: string, message_id: string, emoji: string) -> Message throws ApiError

    /// Tells the channel's readers the user is writing. Send it at most every
    /// 8 seconds while they do; sending the message ends it.
    authed function typing(@claim: Claim, guild_id: string, channel_id: string) throws ApiError

    /// Newest first, with translations for the user's language and English.
    #[kind = "get"]
    authed function get_messages(@claim: Claim, guild_id: string, channel_id: string, before: string?, limit: int) -> [MessageView] throws ApiError

    /// Marks the channel read up to `message_id`; never moves backwards.
    /// Sending a message marks its channel read for the author.
    authed function ack(@claim: Claim, guild_id: string, channel_id: string, message_id: string) -> ReadState throws ApiError
}

/// Events reach a session by long polling (`poll`) or over a WebSocket at
/// `GET /gateway/ws?session_id=...&after=...`, authorized with the same
/// bearer token. The server sends each `EventBatch` as one JSON text frame,
/// as soon as events exist; the client sends nothing. Resume after a drop by
/// opening the socket again with the last `next`. Close code 4404 means the
/// session is gone, like `poll`'s `not_found`.
interface Gateway {
    authed function connect(@claim: Claim) -> Ready throws ApiError

    #[kind = "get"]
    authed function poll(@claim: Claim, session_id: string, after: int, wait_ms: int) -> EventBatch throws ApiError
}
