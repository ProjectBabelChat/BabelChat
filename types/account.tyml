// Account API
//
// The production Account service is closed: it also handles billing and
// Discord account linking. This file is the contract the OSS services rely
// on, implemented by a development stub (server/account).
//
// Tokens are JWTs. Edges verify them locally; they never call the Account
// service on the request path.
//
// See docs/architecture/overview.md.

type Registration {
    name: string
    password: string
    /// BCP 47, e.g. "ja-JP".
    locale: string
    /// Needed when sign-ups are by invitation only.
    signup_code: string?
}

type Credentials {
    name: string
    password: string
}

type Token {
    jwt: string
    user_id: string
    /// As registered; sign-in ignores case.
    name: string
    expires_at: int
}

/// Personal settings. They follow the user across guilds and, through the
/// SDK, across platforms.
type UserSettings {
    locale: string
    /// Translate on device even languages a guild does not declare.
    translate_outside_set: bool
    /// Show the original text next to translations.
    show_original: bool
}

type PasswordChange {
    password: string
    new_password: string
}

/// Lets people create accounts while sign-ups are by invitation only.
/// Operators make them (`babel-admin signup-code`).
type NewSignupCode {
    /// How many accounts it may create.
    uses: int
    /// How long it stays valid.
    hours: int
}

type SignupCode {
    code: string
    uses_left: int
    expires_at: int
}

/// Tokens of `user_id` issued before `not_before` (ms) are no longer valid:
/// the user signed out their other devices or changed their password.
type Revocation {
    user_id: string
    not_before: int
    /// Position in the stream of revocations.
    version: int
}

type RevocationBatch {
    revocations: [Revocation]
    /// Pass as `after` to the next watch.
    version: int
}

type User {
    id: string
    name: string
}

enum AccountError {
    "name_taken"
    "invalid_credentials"
    "invalid_request"
    "not_found"
    /// Sign-ups are closed.
    "signups_closed"
    /// Sign-ups are by invitation, and the code is missing, expired or
    /// used up.
    "invalid_signup_code"
    /// The Account service could not be reached.
    "unavailable"
}

interface Account {
    function register(@body: Registration) -> Token throws AccountError

    function login(@body: Credentials) -> Token throws AccountError

    #[kind = "get"]
    function get_user(user_id: string) -> User throws AccountError

    #[kind = "get"]
    function get_settings(user_id: string) -> UserSettings throws AccountError

    function put_settings(user_id: string, @body: UserSettings) -> UserSettings throws AccountError

    /// Signs the user's other devices out, like `sign_out_others`.
    function change_password(user_id: string, @body: PasswordChange) -> Token throws AccountError

    /// Revokes every token of the user and returns a new one for the
    /// device asking.
    function sign_out_others(user_id: string) -> Token throws AccountError

    /// Operators only.
    function create_signup_code(@body: NewSignupCode) -> SignupCode throws AccountError

    /// Long poll: revocations after version `after`; from 0, all of those
    /// that still matter (older ones only concern tokens that have expired).
    /// Edges follow it and refuse revoked tokens.
    #[kind = "get"]
    function watch_revocations(after: int, wait_ms: int) -> RevocationBatch throws AccountError
}
