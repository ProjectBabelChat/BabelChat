// Message Cell API (internal)
//
// A Message Cell owns a set of guilds: their channels, members and original
// messages. It is never reachable from the internet; Edges call it after
// authenticating the user and resolving which cell holds the guild.
//
// Every change is appended to the guild's event log. The log drives Edge
// fan-out (poll_events) and the outbox that forwards messages and context to
// the guild's Translation Cell.
//
// Permission checks happen here, because roles are guild data. Edges ask
// `check_permission` before calling other services on a user's behalf.
//
// See docs/architecture/message-cell.md.

type Guild {
    id: string
    name: string
    description: string?
    owner_id: string
    created_at: int
}

enum ChannelKind {
    "category"
    "text"
    "thread"
}

type Channel {
    id: string
    guild_id: string
    kind: ChannelKind
    name: string
    topic: string?
    /// Category of a channel, or channel of a thread.
    parent_id: string?
    /// For threads: the message the thread was started from.
    starter_message_id: string?
    created_at: int
    /// Newest message ever sent here; compared with read states to tell
    /// unread channels.
    last_message_id: string?
    /// Who made it; absent on channels made before this was kept. A
    /// thread's creator may rename and delete it.
    created_by: string?
}

enum Role {
    "owner"
    "member"
}

type Member {
    user_id: string
    name: string
    role: Role
    joined_at: int
}

/// Everyone who reacted to a message with one emoji.
type Reaction {
    /// A Unicode emoji. Room is left for a guild's own emoji as
    /// `custom:<id>`, usable in other guilds too; none exist yet.
    emoji: string
    /// In the order they reacted.
    user_ids: [string]
}

type Message {
    /// Time-ordered and unique within the guild. Carries no cell number.
    id: string
    guild_id: string
    channel_id: string
    author_id: string
    author_name: string
    /// Forwarded to the Translation Cell to complete language detection.
    /// Internal: Edges do not expose it.
    author_locale: string?
    text: string
    /// A message in the same channel this one answers.
    reply_to: string?
    /// Members this message notifies: `@name`s in the text, and the author
    /// of the message replied to. Set by the cell; absent on messages stored
    /// before mentions existed.
    mentions: [string]?
    /// Starts at 1 and increases on every edit.
    rev: int
    created_at: int
    edited_at: int?
    /// In the order first used. Reacting changes neither `rev` nor
    /// `edited_at`. Absent on messages stored before reactions existed.
    reactions: [Reaction]?
}

/// How far one member has read one channel.
type ReadState {
    channel_id: string
    /// Later messages are unread. Starts at the member's join time, so it
    /// may name no message.
    last_read_id: string
    /// Messages after `last_read_id` that mention the member.
    mention_count: int
}

enum NotifyLevel {
    "all"
    "mentions"
    "none"
}

type ChannelNotify {
    channel_id: string
    level: NotifyLevel
}

/// What one member wants to be notified of in one guild. Channel entries
/// override the guild's level; a thread follows its channel unless it has
/// its own entry.
type NotificationSettings {
    guild_id: string
    level: NotifyLevel
    channels: [ChannelNotify]
}

type Ban {
    user_id: string
    name: string
    banned_by: string
    banned_at: int
}

type GuildSnapshot {
    guild: Guild
    channels: [Channel]
    members: [Member]
    /// The requesting member's, one per channel.
    read_states: [ReadState]
    notifications: NotificationSettings
    /// Sequence number of the last event included in this snapshot.
    last_seq: int
}

type NewGuild {
    /// Assigned by the Directory.
    guild_id: string
    /// Translation Cell assigned by the Directory; the outbox forwards here.
    translation_cell: string
    name: string
    description: string?
    owner_id: string
    owner_name: string
}

type NewChannel {
    guild_id: string
    user_id: string
    kind: ChannelKind
    name: string
    topic: string?
    parent_id: string?
    starter_message_id: string?
}

type NewMessage {
    guild_id: string
    channel_id: string
    user_id: string
    /// The author's locale, forwarded to the Translation Cell to complete
    /// language detection.
    author_locale: string?
    text: string
    reply_to: string?
}

type GuildUpdate {
    guild_id: string
    user_id: string
    name: string
    description: string?
}

type ChannelUpdate {
    guild_id: string
    channel_id: string
    user_id: string
    name: string
    topic: string?
}

type MessageEdit {
    guild_id: string
    channel_id: string
    message_id: string
    user_id: string
    text: string
}

/// Lets anyone holding it join the guild. Lives with the guild, so it moves
/// with it and dies with it.
type Invite {
    /// Random; the Edge builds the public code from it and the guild ID.
    secret: string
    guild_id: string
    created_by: string
    created_at: int
    expires_at: int?
    max_uses: int?
    uses: int
}

type NewInvite {
    guild_id: string
    user_id: string
    expires_at: int?
    max_uses: int?
}

type DeletedMessage {
    channel_id: string
    message_id: string
}

/// One member added or took back one reaction.
type ReactionChange {
    channel_id: string
    message_id: string
    emoji: string
    user_id: string
    /// How many reacted with `emoji` after the change, so applying the
    /// same change twice does no harm.
    count: int
}

/// One member is writing in a channel.
type Typing {
    channel_id: string
    user_id: string
}

enum GuildEventKind {
    "guild_created"
    /// Name or description (`guild`).
    "guild_updated"
    /// The guild's last event but its members' removals, which follow
    /// (`member_removed`, one per member).
    "guild_deleted"
    "member_joined"
    "member_left"
    /// Kicked or banned.
    "member_removed"
    "channel_created"
    /// Renamed, a new topic, or out of a deleted category.
    "channel_updated"
    /// With its messages. A channel's threads go first, each with its own
    /// event.
    "channel_deleted"
    "message_created"
    "message_edited"
    "message_deleted"
    "reaction_added"
    "reaction_removed"
    /// Not kept anywhere but the log; Edges pass it on and forget it.
    "typing"
    /// One member's read marker moved (`user_id`, `read_state`). Edges pass
    /// it to that member's sessions only, on whichever Edge they are.
    "read_state_updated"
    /// One member's notification settings changed (`user_id`,
    /// `notifications`); for that member's sessions only.
    "notifications_updated"
}

/// One entry of a guild's event log. Exactly one payload is set, chosen by
/// `kind`; events about one member also name them in `user_id`.
type GuildEvent {
    seq: int
    kind: GuildEventKind
    guild: Guild?
    member: Member?
    channel: Channel?
    message: Message?
    deleted: DeletedMessage?
    reaction: ReactionChange?
    typing: Typing?
    user_id: string?
    read_state: ReadState?
    notifications: NotificationSettings?
}

type GuildEventBatch {
    events: [GuildEvent]
    /// Pass as `after` to the next poll.
    next: int
    /// Sequence number of the newest event of the guild. Polling with an
    /// `after` beyond it returns at once, so followers can start at the head.
    head: int
    /// Events up to this sequence number were trimmed from the log. A
    /// follower whose `after` is below it has missed some.
    trimmed: int
}

enum Permission {
    "view"
    "send_messages"
    "create_invite"
    "manage_guild"
}

/// One stored entry of a guild, on its way to another cell. Keys and values
/// are hex: they are the cell's own storage format.
type GuildEntry {
    table: string
    key: string
    value: string
}

type GuildExport {
    entries: [GuildEntry]
    /// Pass to the next export; null once everything is exported.
    cursor: string?
}

type GuildImport {
    guild_id: string
    entries: [GuildEntry]
}

enum MessageCellError {
    "not_found"
    "forbidden"
    "invalid_request"
    "unavailable"
    /// The guild lives on another cell now: ask the Directory again.
    "moved"
}

interface MessageCell {
    function create_guild(@body: NewGuild) -> Guild throws MessageCellError

    /// Managers only.
    function update_guild(@body: GuildUpdate) -> Guild throws MessageCellError

    /// The owner only. Everything the guild holds goes; only its log stays
    /// a while, for Edges to read to the end, and its record, answering
    /// `not_found`.
    function delete_guild(guild_id: string, user_id: string) throws MessageCellError

    /// Fails with `forbidden` unless the user is a member.
    #[kind = "get"]
    function get_guild(guild_id: string, user_id: string) -> GuildSnapshot throws MessageCellError

    /// Fails with `not_found` unless the invite is valid. Members joining
    /// again succeed whatever the invite.
    function join_guild(guild_id: string, invite: string, user_id: string, user_name: string) -> GuildSnapshot throws MessageCellError

    function create_invite(@body: NewInvite) -> Invite throws MessageCellError

    /// The invite's creator or a manager may revoke it.
    function revoke_invite(guild_id: string, secret: string, user_id: string) throws MessageCellError

    /// Valid invites: all of them for managers, a member's own otherwise.
    #[kind = "get"]
    function get_invites(guild_id: string, user_id: string) -> [Invite] throws MessageCellError

    /// The owner cannot leave (`invalid_request`).
    function leave_guild(guild_id: string, user_id: string) throws MessageCellError

    /// Managers only. With `ban`, invites no longer let the member back in.
    function remove_member(guild_id: string, user_id: string, member_id: string, ban: bool) throws MessageCellError

    function unban_member(guild_id: string, user_id: string, member_id: string) throws MessageCellError

    #[kind = "get"]
    function get_bans(guild_id: string, user_id: string) -> [Ban] throws MessageCellError

    /// Marks the channel read up to `message_id` (never backwards) and
    /// recounts the mentions after it.
    function ack(guild_id: string, channel_id: string, user_id: string, message_id: string) -> ReadState throws MessageCellError

    function put_notification_settings(user_id: string, @body: NotificationSettings) -> NotificationSettings throws MessageCellError

    #[kind = "get"]
    function check_permission(guild_id: string, user_id: string, permission: Permission) throws MessageCellError

    function create_channel(@body: NewChannel) -> Channel throws MessageCellError

    /// Managers; for a thread, its creator too.
    function update_channel(@body: ChannelUpdate) -> Channel throws MessageCellError

    /// Managers; for a thread, its creator too. A channel's threads and
    /// messages go with it; a category's channels stay, outside it.
    function delete_channel(guild_id: string, channel_id: string, user_id: string) throws MessageCellError

    function send_message(@body: NewMessage) -> Message throws MessageCellError

    function edit_message(@body: MessageEdit) -> Message throws MessageCellError

    function delete_message(guild_id: string, channel_id: string, message_id: string, user_id: string) throws MessageCellError

    /// Adding a reaction already there, or removing one that is not, changes
    /// nothing. A message holds at most 20 different emoji.
    function add_reaction(guild_id: string, channel_id: string, message_id: string, user_id: string, emoji: string) -> Message throws MessageCellError

    function remove_reaction(guild_id: string, channel_id: string, message_id: string, user_id: string, emoji: string) -> Message throws MessageCellError

    /// Tells the guild's readers the member is writing in the channel.
    function typing(guild_id: string, channel_id: string, user_id: string) throws MessageCellError

    /// Newest first, strictly before `before` when given.
    #[kind = "get"]
    function get_messages(guild_id: string, channel_id: string, user_id: string, before: string?, limit: int) -> [Message] throws MessageCellError

    /// Long poll on the guild's event log, for Edges.
    #[kind = "get"]
    function poll_events(guild_id: string, after: int, wait_ms: int) -> GuildEventBatch throws MessageCellError

    // ---- Moving a guild (called by the Directory) -------------------------

    /// Holds the guild's writes (they wait) and returns once its outbox has
    /// delivered everything, so the guild can be copied as it is.
    function freeze_guild(guild_id: string) throws MessageCellError

    /// A page of the frozen guild's entries, from `cursor` on.
    #[kind = "get"]
    function export_guild(guild_id: string, cursor: string?, limit: int) -> GuildExport throws MessageCellError

    /// Stores exported entries. The guild becomes whole here with its last
    /// page, but is only reached once the Directory points at it.
    function import_guild(@body: GuildImport) throws MessageCellError

    /// Ends a move at the old cell: `moved` drops the guild here (calls
    /// about it answer `moved` from now on); otherwise writes resume.
    function finish_move(guild_id: string, moved: bool) throws MessageCellError

    /// Drops whatever this cell holds of a guild: an import that did not
    /// finish.
    function discard_guild(guild_id: string) throws MessageCellError
}
